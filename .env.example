# === L1 自托管聚合搜索（可选） ===
# SEARXNG_URL=http://127.0.0.1:8080

# === L2 BYOK 商业高质量网页搜索（按需配置，缺 key 显式报 missing-credential） ===
# DEEPSEEK_API_KEY=
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# 若不希望自动只读复用 MCPS 同目录 .env 中的白名单凭据，设为 1：
# OMNI_NO_MCPS_ENV=0

# === 学术可选加速 Key（无 key 也可匿名访问） ===
# OPENALEX_API_KEY=

# === 桥接现有 multi-code-platform-searcher（复用 23 个代码/学术/包源） ===
MCPS_SCRIPT_PATH=D:/01 项目/skill/multi-code-platform-searcher/mcps.py

# === 禁用特定引擎（逗号分隔引擎 ID） ===
# OMNI_DISABLE=
