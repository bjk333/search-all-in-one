use_default_settings: true

server:
  secret_key: "replace-with-local-random-hex"
  limiter: false
  image_proxy: false

search:
  formats:
    - html
    - json

outgoing:
  request_timeout: 6.0
  max_request_timeout: 10.0

engines:
  - name: bing
    disabled: false
  - name: mojeek
    disabled: false
  - name: yahoo
    disabled: false
  - name: sogou
    disabled: false
  - name: wikipedia
    disabled: false
